@model E_commerce_iti.ViewModels.RegisterViewModel

<div class="auth-page">
    <div class="auth-card auth-card-wide">
        <div class="auth-header">
            <span class="auth-eyebrow">Create account</span>
            <h2>Register</h2>
            <p class="auth-subtext">Join us to start shopping and track your orders.</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post" class="auth-form">

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="FName"></label>
                    <input asp-for="FName" class="form-control" />
                    <span asp-validation-for="FName" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LName"></label>
                    <input asp-for="LName" class="form-control" />
                    <span asp-validation-for="LName" class="field-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <button type="submit" class="btn btn-primary auth-submit">Register</button>

        </form>
    </div>
</div>

<style>
    .auth-page {
        display: flex;
        justify-content: center;
        padding: 2rem 1rem 3rem;
    }

    .auth-card {
        width: 100%;
        max-width: 420px;
        background-color: var(--surface-color, #fff);
        border: 1px solid var(--border-color, #e6dfd5);
        border-radius: var(--radius-lg, 16px);
        box-shadow: var(--shadow-soft, 0 2px 10px rgba(28,26,25,0.05));
        padding: 2.5rem 2.25rem;
    }

    .auth-card-wide {
        max-width: 520px;
    }

    .auth-header {
        text-align: center;
        margin-bottom: 1.75rem;
    }

    .auth-eyebrow {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--primary-color, #6d1f2a);
        margin-bottom: 0.5rem;
    }

    .auth-header h2 {
        margin: 0 0 0.4rem;
        font-size: 1.75rem;
    }

    .auth-subtext {
        color: var(--muted-text, #6b6560);
        font-size: 0.92rem;
        margin: 0;
    }

    .auth-form .form-row {
        display: flex;
        gap: 1rem;
    }

        .auth-form .form-row .form-group {
            flex: 1;
            min-width: 0;
        }

    .auth-form .form-group {
        margin-bottom: 1.25rem;
    }

    .auth-form label {
        display: block;
        font-size: 0.88rem;
        font-weight: 500;
        color: var(--text-color, #1c1a19);
        margin-bottom: 0.4rem;
    }

    .auth-form .form-control {
        width: 100%;
        border: 1px solid var(--border-color, #e6dfd5);
        border-radius: var(--radius-md, 10px);
        padding: 0.65rem 0.9rem;
        font-size: 0.95rem;
        background-color: #fff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .auth-form .form-control:focus {
            outline: none;
            border-color: var(--primary-color, #6d1f2a);
            box-shadow: 0 0 0 3px rgba(109, 31, 42, 0.12);
        }

    .field-error {
        display: block;
        color: #b3261e;
        font-size: 0.82rem;
        margin-top: 0.3rem;
    }

    .validation-summary {
        color: #b3261e;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .auth-submit {
        width: 100%;
        padding: 0.75rem;
        font-size: 0.95rem;
        font-weight: 600;
    }

    @@media (max-width: 480px) {
        .auth-form .form-row {
            flex-direction: column;
            gap: 0;
        }
    }
</style>