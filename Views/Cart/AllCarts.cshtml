@model ICollection<E_commerce_iti.ViewModels.CartViewModel>

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>All Carts</h1>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No carts found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped table-hover">

                <thead>
                    <tr>
                        <th>Cart ID</th>
                        <th>User ID</th>
                        <th>User Name</th>
                        <th>Items</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var cart in Model)
                    {
                        <tr>
                            <td>@cart.Id</td>

                            <td>@cart.UserId</td>

                            <td>@cart.UserName</td>

                            <td>
                                @cart.Items.Count
                            </td>

                            <td>
                                <a asp-controller="Admin"
                                   asp-action="CartDetails"
                                   asp-route-id="@cart.Id"
                                   class="btn btn-primary btn-sm">
                                    View Cart
                                </a>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>