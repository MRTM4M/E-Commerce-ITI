@model List<E_commerce_iti.ViewModels.CartViewModel>

<div class="container mt-5">

    <h1>All Carts</h1>

    <table class="table table-striped">

        <thead>
            <tr>
                <th>Cart ID</th>
                <th>User ID</th>
                <th>User Name</th>
                <th>Items</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var cart in Model)
            {
                <tr>
                    <td>@cart.Id</td>

                    <td>@cart.UserId</td>

                    <td>@cart.UserName</td>

                    <td>@cart.Items.Count</td>

                    <td>
                        <form asp-action="Delete"
                              asp-route-id="@cart.Id"
                              method="post">

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete
                            </button>

                        </form>
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>