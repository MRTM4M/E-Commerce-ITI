@model ICollection<E_commerce_iti.ViewModels.CartViewModel>

<div class="admin-page">

    <div class="admin-page-header">
        <div>
            <span class="admin-eyebrow">Admin</span>
            <h1 class="admin-title">All Carts</h1>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="admin-empty-state">
            No carts found.
        </div>
    }
    else
    {
        <div class="admin-table-card">
            <div class="table-responsive">

                <table class="table table-hover admin-table">

                    <thead>
                        <tr>
                            <th>Cart ID</th>
                            <th>User ID</th>
                            <th>User Name</th>
                            <th>Items</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var cart in Model)
                        {
                            <tr>
                                <td>@cart.Id</td>

                                <td>@cart.UserId</td>

                                <td>@cart.UserName</td>

                                <td>
                                    <span class="admin-item-count">@cart.Items.Count</span>
                                </td>

                                <td>
                                    <a asp-controller="Admin"
                                       asp-action="CartDetails"
                                       asp-route-id="@cart.Id"
                                       class="btn btn-primary btn-sm">
                                        View Cart
                                    </a>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    }

</div>

<style>
    .admin-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1rem 0 3rem;
    }

    .admin-page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .admin-eyebrow {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--primary-color, #6d1f2a);
        margin-bottom: 0.35rem;
    }

    .admin-title {
        font-size: 1.9rem;
        margin: 0;
    }

    .admin-empty-state {
        text-align: center;
        padding: 2.5rem 1.5rem;
        background-color: var(--secondary-surface, #f2ece3);
        border: 1px solid var(--border-color, #e6dfd5);
        border-radius: var(--radius-lg, 16px);
        color: var(--muted-text, #6b6560);
    }

    .admin-table-card {
        background-color: var(--surface-color, #fff);
        border: 1px solid var(--border-color, #e6dfd5);
        border-radius: var(--radius-lg, 16px);
        box-shadow: var(--shadow-soft, 0 2px 10px rgba(28,26,25,0.05));
        overflow: hidden;
    }

    .admin-table {
        margin-bottom: 0;
    }

        .admin-table thead th {
            background-color: var(--secondary-surface, #f2ece3);
            border-bottom: 1px solid var(--border-color, #e6dfd5);
            color: var(--muted-text, #6b6560);
            font-weight: 600;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 0.9rem 1.25rem;
        }

        .admin-table tbody td {
            padding: 0.9rem 1.25rem;
            vertical-align: middle;
            border-color: var(--border-color, #e6dfd5);
            color: var(--text-color, #1c1a19);
        }

        .admin-table tbody tr:hover {
            background-color: var(--secondary-surface, #f2ece3);
        }

    .admin-item-count {
        display: inline-block;
        min-width: 28px;
        text-align: center;
        padding: 0.15rem 0.5rem;
        border-radius: 999px;
        background-color: rgba(109, 31, 42, 0.08);
        color: var(--primary-color, #6d1f2a);
        font-weight: 600;
        font-size: 0.85rem;
    }

    @@media (max-width: 576px) {
        .admin-page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-title {
            font-size: 1.6rem;
        }
    }
</style>