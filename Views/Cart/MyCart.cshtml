@model E_commerce_iti.ViewModels.CartViewModel

@{
    ViewData["Title"] = "My Cart";

    var grandTotal = Model.Items.Sum(item => item.Total);
}

<div class="cart-page">

    <div class="cart-header">
        <span class="cart-eyebrow">Your Cart</span>
        <h1 class="cart-title">My Cart</h1>
        <p class="cart-customer">Customer: @Model.UserName</p>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="cart-empty-state">
            Your cart is empty.
        </div>
    }
    else
    {
        <div class="cart-table-card">
            <div class="table-responsive">

                <table class="table table-hover align-middle cart-table">

                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td class="cart-product-name">
                                    @item.ProductName
                                </td>

                                <td>
                                    @item.Price.ToString("C")
                                </td>

                                <td>

                                    <div class="cart-qty-control">

                                        <!-- Decrease -->
                                        <form asp-controller="Cart"
                                              asp-action="Decrease"
                                              method="post"
                                              class="cart-qty-form">

                                            <input type="hidden"
                                                   name="itemId"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="cart-qty-btn">
                                                &minus;
                                            </button>

                                        </form>


                                        <span class="cart-qty-value">
                                            @item.Quantity
                                        </span>


                                        <!-- Increase -->
                                        <form asp-controller="Cart"
                                              asp-action="Increase"
                                              method="post"
                                              class="cart-qty-form">

                                            <input type="hidden"
                                                   name="itemId"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="cart-qty-btn">
                                                +
                                            </button>

                                        </form>

                                    </div>

                                </td>

                                <td class="cart-item-total">
                                    @item.Total.ToString("C")
                                </td>

                                <td>

                                    <form asp-controller="Cart"
                                          asp-action="RemoveItem"
                                          method="post">

                                        <input type="hidden"
                                               name="itemId"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Remove
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>


        <!-- Cart Summary -->
        <div class="cart-summary-card">

            <div>
                <span class="cart-summary-label">
                    Grand Total
                </span>

                <span class="cart-summary-value">
                    @grandTotal.ToString("C")
                </span>
            </div>

            <form asp-controller="Order"
                  asp-action="CreateFromCart"
                  method="post">

                @Html.AntiForgeryToken()

                @foreach (var item in Model.Items)
                {
                    <input type="hidden"
                           name="cartItems[@item.Id].ProductId"
                           value="@item.ProductId" />

                    <input type="hidden"
                           name="cartItems[@item.Id].Quantity"
                           value="@item.Quantity" />
                }

                <button type="submit" class="btn btn-primary">
                    Order
                </button>

            </form>

        </div>

    }

</div>

<style>
    .cart-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 1rem 0 3rem;
    }

    .cart-header {
        margin-bottom: 2rem;
    }

    .cart-eyebrow {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--primary-color, #6d1f2a);
        margin-bottom: 0.35rem;
    }

    .cart-title {
        font-size: 1.9rem;
        margin: 0 0 0.5rem;
    }

    .cart-customer {
        color: var(--muted-text, #6b6560);
        margin: 0;
    }

    .cart-empty-state {
        text-align: center;
        padding: 2.5rem 1.5rem;
        background-color: var(--secondary-surface, #f2ece3);
        border: 1px solid var(--border-color, #e6dfd5);
        border-radius: var(--radius-lg, 16px);
        color: var(--muted-text, #6b6560);
    }

    .cart-table-card {
        background-color: var(--surface-color, #fff);
        border: 1px solid var(--border-color, #e6dfd5);
        border-radius: var(--radius-lg, 16px);
        box-shadow: var(--shadow-soft, 0 2px 10px rgba(28,26,25,0.05));
        overflow: hidden;
    }

    .cart-table {
        margin-bottom: 0;
    }

        .cart-table thead th {
            background-color: var(--secondary-surface, #f2ece3);
            border-bottom: 1px solid var(--border-color, #e6dfd5);
            color: var(--muted-text, #6b6560);
            font-weight: 600;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            padding: 0.9rem 1.25rem;
        }

        .cart-table tbody td {
            padding: 0.9rem 1.25rem;
            border-color: var(--border-color, #e6dfd5);
            color: var(--text-color, #1c1a19);
        }

        .cart-table tbody tr:hover {
            background-color: var(--secondary-surface, #f2ece3);
        }

    .cart-product-name {
        font-weight: 500;
    }

    .cart-item-total {
        font-weight: 600;
        color: var(--primary-color, #6d1f2a);
    }

    .cart-qty-control {
        display: flex;
        align-items: center;
        gap: 0.6rem;
    }

    .cart-qty-form {
        margin: 0;
    }

    .cart-qty-btn {
        width: 30px;
        height: 30px;
        border: 1px solid var(--border-color, #e6dfd5);
        background-color: var(--surface-color, #fff);
        color: var(--text-color, #1c1a19);
        border-radius: 50%;
        line-height: 1;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .cart-qty-btn:hover {
            border-color: var(--primary-color, #6d1f2a);
            color: var(--primary-color, #6d1f2a);
            background-color: rgba(109, 31, 42, 0.06);
        }

    .cart-qty-value {
        min-width: 20px;
        text-align: center;
        font-weight: 500;
    }

    .cart-summary-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1.5rem;
        padding: 1.5rem 1.75rem;
        background-color: var(--surface-color, #fff);
        border: 1px solid var(--border-color, #e6dfd5);
        border-radius: var(--radius-lg, 16px);
        box-shadow: var(--shadow-soft, 0 2px 10px rgba(28,26,25,0.05));
    }

    .cart-summary-label {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-color, #1c1a19);
    }

    .cart-summary-value {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--primary-color, #6d1f2a);
    }

    @@media (max-width: 576px) {
        .cart-table thead th,
        .cart-table tbody td {
            padding: 0.65rem 0.75rem;
            font-size: 0.88rem;
        }

        .cart-summary-card {
            flex-direction: column;
            align-items: flex-start;
            gap: 0.5rem;
        }
    }
</style>