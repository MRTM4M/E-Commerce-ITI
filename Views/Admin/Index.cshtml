@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Dashboard</h1>

<div class="row">

    <div class="col-md-4">
        <div class="card p-4">
            <h4>Users</h4>

            <a asp-action="Users"
