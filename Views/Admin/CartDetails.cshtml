@model E_commerce_iti.ViewModels.CartViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page-header">

    <div>
        <span class="admin-eyebrow">Admin</span>
        <h2 class="admin-title">Cart Details</h2>
        <p class="admin-subtext">Cart #@Model.Id</p>
    </div>

    <a asp-action="Carts"
       class="btn btn-outline-secondary">
        Back to Carts
    </a>

</div>

<!-- Cart Information -->

<div class="admin-table-card mb-4">

    <div class="admin-info-body">

        <div class="row">

            <div class="col-md-4 admin-info-block">
                <span class="admin-info-label">Cart ID</span>
                <p class="admin-info-value">#@Model.Id</p>
            </div>

            <div class="col-md-4 admin-info-block">
                <span class="admin-info-label">User ID</span>
                <p class="admin-info-value">@Model.UserId</p>
            </div>

            <div class="col-md-4 admin-info-block">
                <span class="admin-info-label">Customer</span>
                <p class="admin-info-value">@Model.UserName</p>
            </div>

        </div>

    </div>

</div>


<!-- Cart Items -->

<div class="admin-table-card">

    <div class="admin-table-header">
        <h5>Cart Items</h5>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="admin-info-body">
            <div class="cart-empty-state mb-0">
                This cart is empty.
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle admin-table">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Product ID</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model.Items)
                    {
                        <tr>

                            <td>
                                @item.ProductName
                            </td>

                            <td>
                                @item.ProductId
                            </td>

                            <td>
                                @item.Price.ToString("C")
                            </td>

                            <td>
                                @item.Quantity
                            </td>

                            <td class="admin-item-total">
                                @item.Total.ToString("C")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <div class="admin-table-footer">
        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Cancel
        </a>
    </div>

</div>

