@model E_commerce_iti.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="page-container-narrow">

    <div class="page-header-row">
        <div>
            <span class="eyebrow">Admin</span>
            <h1 class="page-title">Edit Product</h1>
        </div>
    </div>

    <div class="surface-card">

        <div class="surface-card-body">

            <form asp-controller="Admin"
                  asp-action="EditProduct"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="form-group">
                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="field-error">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryId"
                           class="form-label">
                        Category ID
                    </label>

                    <input asp-for="CategoryId"
                           class="form-control" />

                    <span asp-validation-for="CategoryId"
                          class="field-error">
                    </span>
                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label asp-for="Price"
                               class="form-label">
                            Price
                        </label>

                        <input asp-for="Price"
                               class="form-control"
                               type="number"
                               step="0.01" />

                        <span asp-validation-for="Price"
                              class="field-error">
                        </span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Stock"
                               class="form-label">
                            Stock
                        </label>

                        <input asp-for="Stock"
                               class="form-control"
                               type="number" />

                        <span asp-validation-for="Stock"
                              class="field-error">
                        </span>
                    </div>

                </div>

                <div class="form-group">
                    <label asp-for="Image"
                           class="form-label">
                        Image
                    </label>

                    <input asp-for="Image"
                           class="form-control" />

                    <span asp-validation-for="Image"
                          class="field-error">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="field-error">
                    </span>
                </div>

                <div class="admin-form-actions">
                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-controller="Admin"
                       asp-action="Products"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>

    </div>

</div>

<style>
    .admin-form-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 0.5rem;
    }

    @@media (max-width: 480px) {
        .admin-form-actions {
            flex-direction: column;
        }

            .admin-form-actions .btn {
                width: 100%;
            }
    }
</style>