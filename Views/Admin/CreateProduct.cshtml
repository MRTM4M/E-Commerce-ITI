@model E_commerce_iti.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Create Product";
}

<div class="admin-page">

    <div class="admin-page-header">
        <div>
            <span class="admin-eyebrow">Admin</span>
            <h1 class="admin-title">Create Product</h1>
        </div>
    </div>

    <div class="admin-form-card">

        <form asp-controller="Admin"
              asp-action="CreateProduct"
              method="post"
              class="admin-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-group">
                <label asp-for="Name" class="form-label"></label>

                <input asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="field-error">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId"
                       class="form-label">
                    Category ID
                </label>

                <input asp-for="CategoryId"
                       class="form-control" />

                <span asp-validation-for="CategoryId"
                      class="field-error">
                </span>
            </div>

            <div class="form-row">

                <div class="form-group">
                    <label asp-for="Price"
                           class="form-label">
                        Price
                    </label>

                    <input asp-for="Price"
                           class="form-control"
                           type="number"
                           step="0.01" />

                    <span asp-validation-for="Price"
                          class="field-error">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="Stock"
                           class="form-label">
                        Stock
                    </label>

                    <input asp-for="Stock"
                           class="form-control"
                           type="number" />

                    <span asp-validation-for="Stock"
                          class="field-error">
                    </span>
                </div>

            </div>

            <div class="form-group">
                <label asp-for="Image"
                       class="form-label">
                    Image
                </label>

                <input asp-for="Image"
                       class="form-control" />

                <span asp-validation-for="Image"
                      class="field-error">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Description"
                       class="form-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control"
                          rows="4">
                </textarea>

                <span asp-validation-for="Description"
                      class="field-error">
                </span>
            </div>

            <div class="admin-form-actions">
                <button type="submit"
                        class="btn btn-primary">
                    Create
                </button>

                <a asp-controller="Admin"
                   asp-action="Products"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>

<style>
    .admin-page {
        max-width: 780px;
        margin: 0 auto;
        padding: 1rem 0 3rem;
    }

    .admin-page-header {
        margin-bottom: 1.75rem;
    }

    .admin-eyebrow {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--primary-color, #6d1f2a);
        margin-bottom: 0.35rem;
    }

    .admin-title {
        font-size: 1.9rem;
        margin: 0;
    }

    .admin-form-card {
        background-color: var(--surface-color, #fff);
        border: 1px solid var(--border-color, #e6dfd5);
        border-radius: var(--radius-lg, 16px);
        box-shadow: var(--shadow-soft, 0 2px 10px rgba(28,26,25,0.05));
        padding: 2rem;
    }

    .admin-form .form-row {
        display: flex;
        gap: 1rem;
    }

        .admin-form .form-row .form-group {
            flex: 1;
            min-width: 0;
        }

    .admin-form .form-group {
        margin-bottom: 1.25rem;
    }

    .admin-form .form-label {
        display: block;
        font-size: 0.88rem;
        font-weight: 500;
        color: var(--text-color, #1c1a19);
        margin-bottom: 0.4rem;
    }

    .admin-form .form-control {
        width: 100%;
        border: 1px solid var(--border-color, #e6dfd5);
        border-radius: var(--radius-md, 10px);
        padding: 0.6rem 0.9rem;
        font-size: 0.95rem;
        background-color: #fff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .admin-form .form-control:focus {
            outline: none;
            border-color: var(--primary-color, #6d1f2a);
            box-shadow: 0 0 0 3px rgba(109, 31, 42, 0.12);
        }

    .field-error {
        display: block;
        color: #b3261e;
        font-size: 0.82rem;
        margin-top: 0.3rem;
    }

    .validation-summary {
        color: #b3261e;
        font-size: 0.85rem;
        margin-bottom: 1rem;
    }

    .admin-form-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 0.5rem;
    }

    @@media (max-width: 480px) {
        .admin-form .form-row {
            flex-direction: column;
            gap: 0;
        }

        .admin-form-card {
            padding: 1.5rem;
        }
    }
</style>