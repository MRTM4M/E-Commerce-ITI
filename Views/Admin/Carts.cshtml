@model ICollection<E_commerce_iti.ViewModels.CartViewModel>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>All Carts</h2>
</div>

<div class="card">
    <div class="card-body">

        <table class="table table-hover align-middle">

            <thead>
                <tr>
                    <th>Cart ID</th>
                    <th>User ID</th>
                    <th>Customer</th>
                    <th>Items</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var cart in Model)
                {
                    <tr>
                        <td>#@cart.Id</td>

                        <td>@cart.UserId</td>

                        <td>@cart.UserName</td>

                        <td>
                            <span class="badge bg-primary">
                                @cart.Items.Count Items
                            </span>
                        </td>

                        <td>
                            <a asp-action="CartDetails"
                               asp-route-id="@cart.Id"
                               class="btn btn-sm btn-primary">
                                View Cart
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
</div>