@model E_commerce_iti.ViewModels.ProductViewModel

@{
    ViewData["Title"] = "Delete Product";
}

<div class="admin-page admin-page-narrow">

    <div class="admin-page-header">
        <div>
            <span class="admin-eyebrow">Admin</span>
            <h1 class="admin-title">Delete Product</h1>
        </div>
    </div>

    <div class="delete-warning">
        Are you sure you want to delete this product? This action cannot be undone.
    </div>

    <div class="admin-table-card mb-3">

        <div class="admin-info-body">

            <h3 class="delete-product-name">@Model.Name</h3>

            <div class="row">

                <div class="col-md-4 admin-info-block">
                    <span class="admin-info-label">ID</span>
                    <p class="admin-info-value">@Model.Id</p>
                </div>

                <div class="col-md-4 admin-info-block">
                    <span class="admin-info-label">Category</span>
                    <p class="admin-info-value">@Model.CategoryName</p>
                </div>

                <div class="col-md-4 admin-info-block">
                    <span class="admin-info-label">Price</span>
                    <p class="admin-info-value">@Model.Price.ToString("C")</p>
                </div>

                <div class="col-md-4 admin-info-block">
                    <span class="admin-info-label">Stock</span>
                    <p class="admin-info-value">@Model.Stock</p>
                </div>

            </div>

        </div>

    </div>

    <form asp-controller="Admin"
          asp-action="DeleteProductConfirmed"
          asp-route-id="@Model.Id"
          method="post"
          class="admin-form-actions">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn btn-danger">
            Yes, Delete
        </button>

        <a asp-controller="Admin"
           asp-action="Products"
           class="btn btn-outline-secondary">
            Cancel
        </a>

    </form>

</div>

<style>
    .admin-page {
        max-width: 780px;
        margin: 0 auto;
        padding: 1rem 0 3rem;
    }

    .admin-page-header {
        margin-bottom: 1.5rem;
    }

    .admin-eyebrow {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--primary-color, #6d1f2a);
        margin-bottom: 0.35rem;
    }

    .admin-title {
        font-size: 1.9rem;
        margin: 0;
    }

    .delete-warning {
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        background-color: rgba(179, 38, 30, 0.08);
        border: 1px solid rgba(179, 38, 30, 0.25);
        border-radius: var(--radius-md, 10px);
        color: #b3261e;
        font-weight: 500;
    }

    .admin-table-card {
        background-color: var(--surface-color, #fff);
        border: 1px solid var(--border-color, #e6dfd5);
        border-radius: var(--radius-lg, 16px);
        box-shadow: var(--shadow-soft, 0 2px 10px rgba(28,26,25,0.05));
        overflow: hidden;
    }

    .admin-info-body {
        padding: 1.5rem 1.25rem;
    }

    .delete-product-name {
        margin: 0 0 1.25rem;
        font-size: 1.4rem;
    }

    .admin-info-block {
        margin-bottom: 0.5rem;
    }

    .admin-info-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--muted-text, #6b6560);
        margin-bottom: 0.3rem;
    }

    .admin-info-value {
        margin: 0;
        font-weight: 500;
        color: var(--text-color, #1c1a19);
    }

    .admin-form-actions {
        display: flex;
        gap: 0.75rem;
    }

    @@media (max-width: 480px) {
        .admin-form-actions {
            flex-direction: column;
        }

            .admin-form-actions .btn {
                width: 100%;
            }
    }
</style>