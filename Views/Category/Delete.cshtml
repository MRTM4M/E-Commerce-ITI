@model E_commerce_iti.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="page-container-narrow">

    <div class="page-header-row">
        <div>
            <span class="eyebrow">Admin</span>
            <h1 class="page-title">Delete Category</h1>
        </div>
    </div>

    <div class="warning-banner">
        Are you sure you want to delete this category? This action cannot be undone.
    </div>

    <div class="surface-card mb-3">
        <div class="surface-card-body">

            <div class="row">

                <div class="col-sm-6 info-block">
                    <span class="info-label">Id</span>
                    <p class="info-value">@Model.Id</p>
                </div>

                <div class="col-sm-6 info-block">
                    <span class="info-label">Name</span>
                    <p class="info-value">@Model.Name</p>
                </div>

            </div>

        </div>
    </div>

    <form asp-action="DeleteConfirmed" method="post" class="admin-form-actions">

        <input type="hidden" name="id" value="@Model.Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Cancel
        </a>

    </form>

</div>