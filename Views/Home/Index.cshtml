@{
    ViewData["Title"] = "Home Page";
}

<section class="hero-section">
    <span class="hero-eyebrow">E_commerce_iti</span>
    <h1 class="hero-title">
        Welcome, @User.Identity?.Name
    </h1>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <p class="hero-status hero-status-active">You are logged in.</p>

        @if (User.IsInRole("Admin"))
        {
            <span class="hero-badge hero-badge-admin">You are an Admin 👑</span>
        }
        else if (User.IsInRole("Customer"))
        {
            <span class="hero-badge hero-badge-customer">You are a Customer 🛒</span>
        }
    }
    else
    {
        <p class="hero-status">You are not logged in.</p>
    }
</section>

<style>
    .hero-section {
        text-align: center;
        max-width: 720px;
        margin: 3rem auto 4rem;
        padding: 3rem 2rem;
        background-color: var(--surface-color, #fff);
        border: 1px solid var(--border-color, #e6dfd5);
        border-radius: var(--radius-lg, 16px);
        box-shadow: var(--shadow-soft, 0 2px 10px rgba(28,26,25,0.05));
    }

    .hero-eyebrow {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--primary-color, #6d1f2a);
        margin-bottom: 0.75rem;
    }

    .hero-title {
        font-size: 2.25rem;
        margin: 0 0 1rem;
        word-break: break-word;
    }

    .hero-status {
        color: var(--muted-text, #6b6560);
        font-size: 1rem;
        margin: 0 0 0.5rem;
    }

    .hero-status-active {
        color: var(--text-color, #1c1a19);
    }

    .hero-badge {
        display: inline-block;
        margin-top: 0.5rem;
        padding: 0.45rem 1.1rem;
        border-radius: 999px;
        font-size: 0.88rem;
        font-weight: 500;
    }

    .hero-badge-admin {
        background-color: rgba(109, 31, 42, 0.1);
        color: var(--primary-color, #6d1f2a);
    }

    .hero-badge-customer {
        background-color: var(--secondary-surface, #f2ece3);
        color: var(--text-color, #1c1a19);
    }

    @@media (max-width: 576px) {
        .hero-section {
            margin: 1.5rem 1rem 2.5rem;
            padding: 2rem 1.25rem;
        }

        .hero-title {
            font-size: 1.75rem;
        }
    }
</style>