<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Admin Dashboard</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            body {
                background-color: var(--background-color, #faf7f2);
            }

            /* ---------- Sidebar ---------- */
            .admin-sidebar {
                min-height: 100vh;
                background-color: var(--text-color, #1c1a19);
            }

            .admin-sidebar-brand {
                padding: 1.75rem 1.5rem 1.25rem;
            }

                .admin-sidebar-brand h4 {
                    font-family: 'Playfair Display', Georgia, serif;
                    color: #fff;
                    margin: 0;
                    font-size: 1.3rem;
                    letter-spacing: 0.02em;
                }

                .admin-sidebar-brand span {
                    display: block;
                    font-size: 0.72rem;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                    color: var(--primary-light, #8a3540);
                    font-weight: 600;
                    margin-top: 0.25rem;
                }

            .admin-sidebar nav {
                padding: 0.5rem 0.75rem;
            }

            .admin-sidebar a {
                display: block;
                color: rgba(255, 255, 255, 0.65);
                text-decoration: none;
                padding: 0.65rem 1rem;
                border-radius: var(--radius-md, 10px);
                font-size: 0.92rem;
                font-weight: 500;
                margin-bottom: 0.15rem;
                transition: background-color 0.2s ease, color 0.2s ease;
            }

                .admin-sidebar a:hover {
                    background-color: rgba(255, 255, 255, 0.06);
                    color: #fff;
                }

            .admin-sidebar hr {
                border-color: rgba(255, 255, 255, 0.12);
                margin: 1rem 0.75rem;
            }

            /* ---------- Top navbar ---------- */
            .admin-navbar {
                background-color: var(--surface-color, #fff);
                padding: 1rem 1.75rem;
                border-bottom: 1px solid var(--border-color, #e6dfd5);
            }

                .admin-navbar h5 {
                    margin: 0;
                    font-size: 1.05rem;
                }

                .admin-navbar .admin-welcome {
                    color: var(--muted-text, #6b6560);
                    font-size: 0.9rem;
                }

            /* ---------- Content area ---------- */
            .admin-content {
                padding: 2rem 1.75rem 3rem;
            }

            @@media (max-width: 767px) {
                .admin-sidebar {
                    min-height: auto;
                }
            }
    </style>
</head>

<body>

    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar -->
            <aside class="col-md-3 col-lg-2 p-0 admin-sidebar">

                <div class="admin-sidebar-brand">
                    <h4>E_commerce_iti</h4>
                    <span>Admin Panel</span>
                </div>

                <nav>

                    <a asp-controller="Admin"
                       asp-action="Index">
                        Dashboard
                    </a>

                    <a asp-controller="Admin"
                       asp-action="Users">
                        All Users
                    </a>

                    <a asp-controller="Admin"
                       asp-action="UsersActive">
                        Active Users
                    </a>

                    <a asp-controller="Admin"
                       asp-action="UsersInactive">
                        Inactive Users
                    </a>

                    <a asp-controller="Admin"
                       asp-action="Carts">
                        All Carts
                    </a>

                    <hr />

                    <!-- Orders -->
                    <a asp-controller="Order"
                       asp-action="AdminIndex">
                        Orders
                    </a>

                    <hr />

                    <a asp-controller="Product"
                       asp-action="Index">
                        Back to Website
                    </a>

                </nav>

            </aside>


            <!-- Main Content -->
            <main class="col-md-9 col-lg-10 p-0">

                <!-- Top Navbar -->
                <div class="admin-navbar d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <h5>
                        Admin Dashboard
                    </h5>

                    <div class="d-flex align-items-center gap-3">
                        <span class="admin-welcome">
                            Welcome, Admin
                        </span>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="d-inline">

                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm">
                                Logout
                            </button>

                        </form>
                    </div>

                </div>


                <!-- Page Content -->
                <div class="admin-content">

                    @RenderBody()

                </div>

            </main>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>