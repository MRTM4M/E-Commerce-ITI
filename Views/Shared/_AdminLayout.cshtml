<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Admin Dashboard</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
            body {
                background-color: #f5f6fa;
            }

            .sidebar {
                min-height: 100vh;
                background-color: #212529;
            }

                .sidebar a {
                    color: #adb5bd;
                    text-decoration: none;
                    display: block;
                    padding: 12px 20px;
                }

                    .sidebar a:hover {
                        background-color: #343a40;
                        color: white;
                    }

            .admin-content {
                padding: 30px;
            }

            .admin-navbar {
                background-color: white;
                padding: 15px 25px;
                border-bottom: 1px solid #ddd;
            }
    </style>
</head>

<body>

    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar -->
            <aside class="col-md-3 col-lg-2 p-0 sidebar">

                <div class="p-4 text-white">
                    <h4>Admin Panel</h4>
                </div>

                <nav>

                    <a asp-controller="Admin"
                       asp-action="Index">
                        Dashboard
                    </a>

                    <a asp-controller="Admin"
                       asp-action="Users">
                        All Users
                    </a>

                    <a asp-controller="Admin"
                       asp-action="UsersActive">
                        Active Users
                    </a>

                    <a asp-controller="Admin"
                       asp-action="UsersInactive">
                        Inactive Users
                    </a>

                    <a asp-controller="Admin"
                       asp-action="Carts">
                        All Carts
                    </a>

                    <hr class="text-secondary mx-3" />

                    <a asp-controller="Home"
                       asp-action="Index">
                        Back to Website
                    </a>

                </nav>

            </aside>


            <!-- Main Content -->
            <main class="col-md-9 col-lg-10 p-0">

                <!-- Top Navbar -->
                <div class="admin-navbar d-flex justify-content-between align-items-center">

                    <h5 class="mb-0">
                        Admin Dashboard
                    </h5>

                    <div>
                        <span class="me-3">
                            Welcome, Admin
                        </span>

                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              class="d-inline">

                            <button type="submit"
                                    class="btn btn-outline-danger btn-sm">
                                Logout
                            </button>

                        </form>
                    </div>

                </div>


                <!-- Page Content -->
                <div class="admin-content">

                    @RenderBody()

                </div>

            </main>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>